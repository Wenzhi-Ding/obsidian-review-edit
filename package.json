{
  "name": "obsidian-review-edit",
  "version": "1.0.0",
  "description": "Review note changes against File Recovery snapshots as an inline diff, keep or revert each hunk（基于文件恢复快照的 diff 式改动审查）",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "diff",
    "file recovery",
    "review"
  ],
  "author": "Wenzhi Ding",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^5.2.3",
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "diff": "^5.2.0",
    "obsidian": "^1.5.7"
  }
}
